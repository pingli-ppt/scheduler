[Unit]
Description=Back up Guochu SQLite database
After=guochu.service

[Service]
Type=oneshot
User=guochu
Group=guochu
EnvironmentFile=/etc/guochu/guochu.env
ExecStart=/usr/local/sbin/guochu-backup
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/guochu
