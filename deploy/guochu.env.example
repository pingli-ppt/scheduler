# 复制到 /etc/guochu/guochu.env 后按实际环境修改。
# 本文件不得包含真实密码、会话密钥、Token 或个人数据。

# 内部测试数据库必须位于持久化磁盘，并与正式环境数据库分开。
GUOCHU_DB_PATH=/data/guochu-test.sqlite3

# baseline：实验组和对照组均不生成个性化推荐。
# active：实验组开放个性化推荐，对照组仍不开放。
GUOCHU_EXPERIMENT_PHASE=active

# 微信兼容的中文登录页和安全 Cookie。
GUOCHU_AUTH_ENABLED=true
GUOCHU_HTPASSWD_PATH=/etc/nginx/.htpasswd
GUOCHU_AUTH_USERNAME=guochu
GUOCHU_SESSION_SECRET_PATH=/etc/guochu/session-secret
GUOCHU_SESSION_MAX_AGE_SECONDS=604800

# 当前网页和 API 同域部署，不需要设置 GUOCHU_CORS_ORIGINS。
# 只有分域部署时才取消下一行注释，并填写准确的 HTTPS 网页来源。
# GUOCHU_CORS_ORIGINS=https://app.example.com

# 每日 SQLite 备份。目录需预先创建并归 guochu 用户所有。
GUOCHU_BACKUP_DIR=/var/backups/guochu
GUOCHU_BACKUP_RETENTION_DAYS=14
